# Identifiants de l'app LinkedIn (https://www.linkedin.com/developers/apps -> onglet Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Secret de signature du cookie de session : openssl rand -base64 32
SESSION_SECRET=
# Mot de passe PostgreSQL (facultatif, "jobradar" par défaut ; à fixer AVANT le premier lancement)
POSTGRES_PASSWORD=
# Assistant Gemini (chat flottant, import de profil PDF / texte). Sans clé, ces fonctions sont désactivées.
# Clé : https://aistudio.google.com/apikey (reste côté serveur, jamais envoyée au navigateur)
GEMINI_API_KEY=
# Modèle (doc : https://ai.google.dev/gemini-api/docs/models). gemini-3.8-flash = Flash stable, bon
# rapport coût / latence pour le chat avec outils. Alternatives : gemini-4-hydrogen, gemini-3.5-flash-lite (moins cher).
GEMINI_MODEL=gemini-3.8-flash
# Modèles de secours (séparés par des virgules), essayés dans l'ordre si le précédent est saturé (503/504)
# ou hors quota (429, fréquent sur le palier gratuit). Vide = aucun.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Notation automatique des offres (volume élevé) : modèles les moins chers d'abord (liste).
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Variante de la notation (backend/app/assessments.py) : v1 (historique) ou v2 (données classées de l'offre,
# couverture des compétences, analyse avant les notes, grille ancrée). Mesurer avant de changer :
# backend/scripts/eval_relevance.py --variant v2
SCORING_VARIANT=v1
# Tâche de fond d'évaluation des offres (true / false) et intervalle entre deux passages (secondes)
ASSESSMENT_WORKER=true
ASSESSMENT_INTERVAL_S=120
# Agent de recherche (voir docs/agent.md) : jeton de l'API /api/agent (openssl rand -base64 32). Vide = API désactivée.
AGENT_TOKEN=
# Collecte quotidienne des offres sur les ATS (sans LLM) : activée par défaut, heure de Paris
COLLECTOR=true
COLLECT_TIME=06:30
# Traitements de fond dans le processus de l'API (évaluation, planificateur de collecte, file de tâches) :
# true en local (défaut) ; false en production, où les jobs Container Apps s'en chargent (python -m app.jobs)
RUN_BACKGROUND_THREADS=true
# Offres présélectionnées par similarité (pgvector) et envoyées à Gemini, par utilisateur. Sans modèle
# d'embeddings (le cas en local, sauf FASTEMBED_CACHE_PATH + uv sync --group worker) : les plus récentes.
MATCH_TOP_K=50
# Bêta privée (backend/app/users.py) : adresses autorisées à créer un compte, et code du lien d'invitation
# /?invitation=<code>. Les deux vides (défaut) : inscription ouverte. Les comptes existants gardent l'accès.
BETA_EMAILS=
BETA_INVITE_CODE=
# Essai Pro offert à la création du compte, sans carte bancaire, en jours (0 = pas d'essai). Ex. 14.
TRIAL_DAYS=0
# Offres Free / Pro (voir backend/app/entitlements.py). false (défaut) : tout le monde est Pro, rien n'est masqué.
BILLING_ENABLED=false
# Comptes toujours Pro (e-mails LinkedIn, séparés par des virgules) : vous, les comptes de test
PRO_USER_EMAILS=
# Administrateurs (e-mails LinkedIn, séparés par des virgules) : seuls à pouvoir modifier le radar partagé
# (entreprises, postes, logos, sources). Ignoré si BILLING_ENABLED=false (tout le monde est alors admin).
ADMIN_EMAILS=
# Stripe (https://dashboard.stripe.com/apikeys) : clé SECRÈTE, reste côté serveur (sk_test_… en test, sk_live_… en prod)
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…) : Dashboard > Développeurs > Webhooks, ou affiché par `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix du produit « Mire Pro » (price_…) : abonnement mensuel 10 € TTC, Pass 3 mois 25 € TTC (paiement unique),
# les mêmes que PLAN_LIMITS (entitlements.py) et les CGV
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PASS_3M=
# Ping healthchecks.io à la fin du job quotidien (python -m app.jobs daily) ; vide = pas de ping
HEALTHCHECK_DAILY_URL=
# Récapitulatif des nouvelles offres par e-mail (backend/app/digest.py), envoyé par le job quotidien.
# SMTP_HOST vide = aucun e-mail. N'importe quel fournisseur SMTP (587 = STARTTLS, 465 = TLS direct).
# Fournisseur retenu : Cloudflare Email Service (domaine notifications.kingjulian.fr, SPF/DKIM/DMARC posés par
# Cloudflare). Offre Workers Free : envoi seulement aux destinataires vérifiés du compte ; Workers Paid pour tous.
#   SMTP_HOST=smtp.mx.cloudflare.net  SMTP_PORT=465  SMTP_USER=api_token
#   SMTP_PASSWORD=<jeton d'API Cloudflare « Email Sending: Edit »>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur sur le domaine authentifié chez le fournisseur. Son nom signe le message : un prénom (« Julien de Mire », sans virgule)
# fait moins newsletter qu'une marque seule (onglet Principal de Gmail plutôt que Promotions).
SMTP_FROM=Mire <recapitulatif@notifications.kingjulian.fr>
# Facultatif : adresse que vous lisez, où arrivent les réponses au récapitulatif (en-tête Reply-To)
SMTP_REPLY_TO=
